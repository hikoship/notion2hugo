{
  "name": "notion2hugo",
  "version": "2.0.0",
  "description": "Convert Notion database entries to Hugo articles with automated deployment",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "start": "node worker.js",
    "inventory:images": "node scripts/inventory-images.js",
    "migrate:images": "node scripts/migrate-images.js",
    "import:articles": "node scripts/import-articles.js",
    "export:all": "node scripts/export-all.js",
    "verify:roundtrip": "node scripts/verify-roundtrip.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/converter.test.js",
    "test:e2e": "node --test tests/worker.e2e.test.js",
    "test:live": "node tests/live-notion.e2e.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hikoship/notion2hugo.git"
  },
  "author": "HiKo",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@imagekit/nodejs": "^7.14.0",
    "@notionhq/client": "^2.2.15",
    "@tryfabric/martian": "^1.2.4",
    "dotenv": "^16.4.7",
    "mime-types": "^2.1.35",
    "yaml": "^2.7.0"
  }
}
