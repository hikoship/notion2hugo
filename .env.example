# ==============================================================================
# Notion to Hugo Automation Environment Configuration (Node.js)
# ==============================================================================

# --- Notion API Configuration ---
# Create an internal integration at https://www.notion.so/profile/integrations
# Share/connect your Notion database with this integration.
NOTION_API_KEY=ntn_your_notion_secret_key_here
NOTION_DATABASE_ID=0341d5b6-2282-4928-ae97-ebfb4fc8bff8
NOTION_API_VERSION=2022-06-28

# Polling interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# --- Local Filesystem & Git Repositories ---
HUGO_CONTENT_DIR=/home/hongyuan/GitHub/blog/content/post
GIT_REPO_DIR=/home/hongyuan/GitHub/blog
GIT_BRANCH=main
GIT_REMOTE=origin

GIT_COMMIT_AUTHOR_NAME=hikoship
GIT_COMMIT_AUTHOR_EMAIL=hikoship@users.noreply.github.com

# --- Image Storage (ImageKit.io - 3 GB Free, No Credit Card) ---
# Get your private key at: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/hikoship

# --- Operational Settings ---
LOG_LEVEL=info
LOCK_FILE_PATH=/tmp/notion_hugo_worker.lock
